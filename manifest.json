
{
  "id": "net-speed",
  "name": "Net Speed",
  "version": "0.1.0",
  "author": "master <master@localhost>",
  "description": "Live network download and upload speed monitor for Ryoku.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 320
  },
  "files": [],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Net Speed"
  },
  "dependencies": {
    "commands": []
  },
  "metadata": {
    "settings": [
      {
        "key": "interface",
        "type": "text",
        "label": "Network interface",
        "group": "Network",
        "default": "wlan0"
      }
    ]
  }
}
